global proc shelf_BlueSteel () {
    global string $gBuffStr;
    global string $gBuffStr0;
    global string $gBuffStr1;


    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Refresh all the scripts and reimport the blue steel packages" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Reload Libraries" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "refresh.png" 
        -image1 "refresh.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import sys\nimport importlib\n\npackage_name = \"blue_steel\"\n\ndef force_reload_package(package_name):\n    \"\"\"\n    Completely removes the package and all submodules from sys.modules\n    and then re-imports it. This is more robust than reload() when\n    modules have been renamed or removed.\n    \"\"\"\n    # 1. Identify all modules to remove\n    # We must collect the names first to avoid \"dictionary changed size during iteration\"\n    modules_to_remove = [\n        name for name in sys.modules\n        if name == package_name or name.startswith(package_name + \".\")\n    ]\n\n    if not modules_to_remove:\n        print(f\"No modules found for package: {package_name}\")\n        return\n\n    # 2. Remove them from sys.modules\n    # We sort them in some order? Actually, order doesn't matter for deletion.\n    for name in modules_to_remove:\n        print(f\"Unloading {name}\")\n        del sys.modules[name]\n\n    # 3. Re-import the package\n    print(f\"Re-importing {package_name}\")\n    try:\n        importlib.import_module(package_name)\n    except Exception as e:\n        print(f\"Error re-importing {package_name}: {e}\")\n\nforce_reload_package(package_name)" 
        -sourceType "python"
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Open Blue Steel Editor" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "from maya import cmds\nimport os\nfrom importlib import reload\nimp..." 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "blue_steel_icon.svg" 
        -image1 "blue_steel_icon.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import blue_steel\n\nw = blue_steel.show()" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
} 
